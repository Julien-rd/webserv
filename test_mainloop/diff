+  <script>
+    function updatePreview(formId, previewId) {
+      const form = document.getElementById(formId);
+      const preview = document.getElementById(previewId);
+      const data = new FormData(form);
+      const params = new URLSearchParams();
+      for (const [k, v] of data.entries()) {
+        if (v) params.append(k, v);
+      }
+      const qs = params.toString();
+      preview.textContent = form.action.rhttp:/eplace(location.origin, '') + (qs ? '?' + qs : '');
+    }
+
+    // init previews
+    ['form-get1', 'form-get2'].forEach(id => {
+      const previewId = id.replace('form-', 'preview-');
+      updatePreview(id, previewId);
+    });
