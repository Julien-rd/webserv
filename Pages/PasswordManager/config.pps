
client_timeout 50;
server {
  client_max_body_size        1;
  
  cgi_config .py /usr/bin/python3;
  allow_methods GET POST DELETE;
  root /PasswordManager;
  location /login/ {
  root /PasswordManager;
  index index.html;
  }
  location /error/ {
  root /PasswordManager;
  index index.html;
  }
  location /registration/ {
  root /PasswordManager;
  index index.html;
  allow_methods GET POST DELETE;
  }
  location /dashboard/ {
  root /PasswordManager;
  index index.html;
  }
  location /processing/ {
  root /PasswordManager;
  index index.html;
  }
  
  root /PasswordManager;
  listen 127.0.0.1:7070;
}
